# --- Database (Postgres) ---
# Local dev + production can share one hosted database (e.g. a free Neon project).
# DATABASE_URL = pooled connection string (app runtime)
# DIRECT_URL   = direct connection (prisma db push / migrations); may equal DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/teetime?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/teetime?sslmode=require"

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Notifications ---
# If RESEND_API_KEY is unset, alerts + OTP codes go to the Dev Outbox / server logs.
# RESEND_API_KEY=""
EMAIL_FROM="teetime alerts <alerts@teetime.dev>"

# --- Simulator ---
SIM_DAYS_AHEAD="14"
SIM_TICK_CANCELS="4"
SIM_TICK_BOOKINGS="5"
# If set, /api/tick requires ?key=<this> (use it for the external cron).
# CRON_SECRET=""
